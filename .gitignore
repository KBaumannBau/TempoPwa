# Environment variables / secrets (only the file in the root folder;
# api/.env, api/.env.dev and api/.env.test of Symfony stay versioned)
/.env
!/.env.example
/api/.env.local
/api/.env.local.php
/api/.env.*.local

# Docker
/log/*
!/log/.gitkeep
/docker/php/home/*
!/docker/php/home/.gitkeep
!/docker/php/home/.bashrc

# API
/api/vendor/
/api/var/
/api/public/bundles/
/api/.phpunit.cache/
/api/phpunit.xml

# PWA
/pwa/node_modules/
/pwa/dist/
/pwa/dev-dist/
*.tsbuildinfo

# IDE (project settings are handled by .idea/.gitignore)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Operating system
.DS_Store
Thumbs.db

# Exports
ZEITERF*.DAT
/_tmp/

# Server environment for Mittwald (contains secrets)
/mittwald.env
# Written into the API package by the pipeline (source is VERSION in the root folder)
/api/VERSION
