# Vorlage für /home/p-yt27xz/html/tempo-api/.env.local (nur auf dem Server, nie im Repo).
# Legt die Pipeline beim ersten Deploy selbst an (APP_SECRET zufällig); danach von Hand pflegen.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=<zufällig, z. B. openssl rand -hex 32>
DATABASE_URL="postgresql://<user>:<passwort>@<host>:5432/<db>?serverVersion=16&charset=utf8"
# Origin der PWA, falls sie unter einer anderen Domain läuft (Regex)
CORS_ALLOW_ORIGIN='^https://<domain-der-app>$'
DEFAULT_URI=https://<domain-der-api>
