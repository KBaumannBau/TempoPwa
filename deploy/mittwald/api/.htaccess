# Tempo API on Mittwald (Apache) – root of /html/tempo-api
# If the domain points to tempo-api instead of tempo-api/public, everything still goes to public/.
# So .env.local, vendor/, var/ and config/ are never reachable from outside.
# (If the domain points directly to public/, this file is not used.)
Options -Indexes
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^(.*)$ public/$1 [L]
