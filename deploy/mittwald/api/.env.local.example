# =============================================================================
# Example for /home/p-yt27xz/html/tempo-api/.env.local (Tempo API on Mittwald)
#
# Placed next to the real .env.local as .env.local.example on every deploy (for orientation only).
# The real .env.local lives only on the server and is never overwritten. The pipeline only adds
# missing values and placeholders (change-me) there: APP_SECRET is generated randomly on the server,
# DATABASE_URL comes from the repo secret TEMPO_API_DATABASE_URL, the rest from .github/workflows/deploy.yml.
# Own changes to the .env.local are kept.
# =============================================================================

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=<zufällig, z. B. openssl rand -hex 32>

# PostgreSQL 17 of the test instance: Supabase "tempo-test", session pooler (IPv4), always with TLS (ADR 0003)
DATABASE_URL="postgresql://postgres.<projekt-ref>:<passwort>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?serverVersion=17&charset=utf8&sslmode=require"

# Origin of the PWA (regex), as long as it runs on its own domain
CORS_ALLOW_ORIGIN='^https://tempo-app\.p-yt27xz\.project\.space$'

DEFAULT_URI=https://tempo-api.p-yt27xz.project.space
