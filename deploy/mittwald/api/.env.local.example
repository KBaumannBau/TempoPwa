# =============================================================================
# Beispiel für /home/p-yt27xz/html/tempo-api/.env.local (Tempo-API auf Mittwald)
#
# Wird bei jedem Deploy als .env.local.example neben die echte .env.local gelegt (nur zur Orientierung).
# Die echte .env.local liegt nur auf dem Server und wird nie überschrieben. Die Pipeline ergänzt dort
# nur fehlende Werte und Platzhalter (change-me): APP_SECRET wird auf dem Server zufällig erzeugt,
# DATABASE_URL kommt aus dem Repo-Secret TEMPO_API_DATABASE_URL, der Rest aus .github/workflows/deploy.yml.
# Eigene Änderungen an der .env.local bleiben erhalten.
# =============================================================================

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=<zufällig, z. B. openssl rand -hex 32>

# PostgreSQL 17 der Testinstanz: Supabase "tempo-test", Session-Pooler (IPv4), immer mit TLS (ADR 0003)
DATABASE_URL="postgresql://postgres.<projekt-ref>:<passwort>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?serverVersion=17&charset=utf8&sslmode=require"

# Origin der PWA (Regex), solange sie unter einer eigenen Domain läuft
CORS_ALLOW_ORIGIN='^https://tempo-app\.p-yt27xz\.project\.space$'

DEFAULT_URI=https://tempo-api.p-yt27xz.project.space
