# Tempo-API auf Mittwald (Apache) – Front-Controller für Symfony
# Lokal läuft nginx (docker/nginx/conf); diese Datei kommt nur beim Deploy nach api/public/.
DirectoryIndex index.php
Options -Indexes

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Basis-Pfad ermitteln (funktioniert auch in einem Unterordner)
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # Authorization-Header an PHP durchreichen
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # /index.php/… auf die saubere Adresse umleiten
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # Vorhandene Dateien (z. B. /bundles/…) direkt ausliefern, sonst Symfony
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
