# Vorlage für .env (cp .env.example .env). .env ist ignoriert und wird nie committet.
# Platzhalter "change-me" unbedingt ersetzen.

# --- Ports -------------------------------------------------------------------
HOST_IP=0.0.0.0
HTTP_PORT=8011
DB_PORT=5432

# --- PWA ---------------------------------------------------------------------
# dev = Vite-Devserver mit HMR hinter nginx, prod = statischer Build (pwa/dist)
PWA_MODUS=dev
# 1 = Dateiänderungen per Polling erkennen (nur falls HMR keine Änderungen sieht)
VITE_POLLING=0

# --- Symfony -----------------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1
# z. B.: openssl rand -hex 32
APP_SECRET=change-me

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=tempo
POSTGRES_USER=tempo
POSTGRES_PASSWORD=change-me

# --- Basic Auth (optional, nur Testinstanzen) ----------------------------------
# Format: user:pass,user:pass – leer lassen für keine Basic Auth
BASIC_AUTH_USERS=
