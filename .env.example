# Template for .env (cp .env.example .env). .env is ignored and never committed.
# Always replace the placeholder "change-me".

# --- Ports -------------------------------------------------------------------
HOST_IP=0.0.0.0
HTTP_PORT=8011
DB_PORT=5432

# --- PWA ---------------------------------------------------------------------
# dev = Vite dev server with HMR behind nginx, prod = static build (pwa/dist)
PWA_MODE=dev
# 1 = detect file changes by polling (only if HMR does not see changes)
VITE_POLLING=0

# --- Symfony -----------------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1
# e.g.: openssl rand -hex 32
APP_SECRET=change-me

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=tempo
POSTGRES_USER=tempo
POSTGRES_PASSWORD=change-me

# --- Basic auth (optional, test instances only) -------------------------------
# Format: user:pass,user:pass – leave empty for no basic auth
BASIC_AUTH_USERS=
